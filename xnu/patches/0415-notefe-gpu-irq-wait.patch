index c37636f..4105d5b 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -273,6 +273,30 @@ a5xelte_send_ipi(unsigned int logical)
 	a5_gic_write32(a5_gicd_base, 0xf00,

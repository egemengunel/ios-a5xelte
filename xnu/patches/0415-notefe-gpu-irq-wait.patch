+
+/*
+ * Note FE (0415): route one shared peripheral interrupt (level, Group 1, priority 0xa0) to a logical CPU and enable
+ * it. Used for the Mali's job/MMU/GPU lines (INTID 256-258, TWRP's /proc/interrupts). False if not possible.
+ */
+bool
+herolte_gic_route_spi(uint32_t intid, unsigned int logical)
+{
+	if (!a5_gicd_base || intid < 32 || intid >= 1020 || logical >= SWEET_SMP_MAX_CPUS ||
+	    a5_gic_cpu_masks[logical] == 0) {
+		return false;
+	}
+	unsigned int word = (intid / 32) * 4, bit = intid % 32;
+	a5_gic_write32(a5_gicd_base, 0x180 + word, 1U << bit);                  /* ICENABLER: off while set up */
+	a5_gic_write32(a5_gicd_base, 0x080 + word, a5_gic_read32(a5_gicd_base, 0x080 + word) | (1U << bit));
+	*(volatile uint8_t *)(a5_gicd_base + 0x400 + intid) = 0xa0;            /* IPRIORITYR */
+	*(volatile uint8_t *)(a5_gicd_base + 0x800 + intid) = a5_gic_cpu_masks[logical];  /* ITARGETSR */
+	unsigned int cfg = 0xc00 + (intid / 16) * 4, shift = (intid % 16) * 2;
+	a5_gic_write32(a5_gicd_base, cfg, a5_gic_read32(a5_gicd_base, cfg) & ~(3U << shift));  /* level */
+	a5_gic_write32(a5_gicd_base, 0x280 + word, 1U << bit);                  /* ICPENDR */
+	a5_gic_write32(a5_gicd_base, 0x100 + word, 1U << bit);                  /* ISENABLER */
+	__builtin_arm_dsb(DSB_SY);
+	return (a5_gic_read32(a5_gicd_base, 0x100 + word) & (1U << bit)) != 0;
+}
 #endif
 

From: Note FE port
Subject: [PATCH] gracerlte: log why a GPU buffer fails (VA, tables, memory); charger watchdog cut-off 60 C

diff --git a/bsd/dev/herolte_battery.c b/bsd/dev/herolte_battery.c
index 391a123..324025a 100644
--- a/bsd/dev/herolte_battery.c
+++ b/bsd/dev/herolte_battery.c
@@ -171,7 +171,7 @@ fg_word(uint8_t reg, uint16_t *value)
  * WDTCLR, bit 0) at every health poll; TWRP showed CNFG_00 0x15 while charging. Nothing cleared it under iOS, so about
  * 80 s after the hand-over the charger stopped ("not charging while iOS runs"). Read: DETAILS_00 0xb3 (CHGIN_DTLS
  * bits 6:5, 3 = input valid), DETAILS_01 0xb4 (CHG_DTLS bits 3:0: 0-3 charging, 4 done; BAT_DTLS 6:4), CNFG_00 0xb7.
- * Written: only WDTCLR, as Android does, while the hottest SoC sensor is under 50 C (the battery's thermistor is read
+ * Written: only WDTCLR, as Android does, while the hottest SoC sensor is under 60 C (0413; was 50) (the battery's thermistor is read
  * by Android through an ADC we don't drive): above it, or if this kernel stops, the watchdog ends charging by itself.
  * Boot-arg herochgwdt=0: read only.
  */
@@ -185,7 +185,7 @@ fg_word(uint8_t reg, uint16_t *value)
 #define CHG_CNFG_09     0xc0
 #define CHG_WDTEN       0x10u
 #define CHG_WDTCLR      0x01u
-#define CHG_KICK_MAX_C  50
+#define CHG_KICK_MAX_C  60      /* 0413: 50 cut the watchdog under load (SoC sensors, not the battery) */
 
 static bool
 chg_byte(uint8_t reg, uint8_t *value)
diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 93fee02..99200b1 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1927,6 +1927,29 @@ herolte_gpu_va_alloc(uint64_t bytes)
 	return va;
 }
 
+/* Note FE 0413: how full the user GPU VA is, and its largest free run, when a buffer fails. */
+void herolte_gpu_va_report(void);
+void
+herolte_gpu_va_report(void)
+{
+	unsigned used = 0, run = 0, best = 0, tables = 0;
+	lck_mtx_lock(hg_mtx);
+	for (unsigned c = 0; c < HGU_CHUNKS; c++) {
+		if (hgu_used[c / 64] & (1ull << (c % 64))) {
+			used++;
+			run = 0;
+		} else if (++run > best) {
+			best = run;
+		}
+	}
+	for (unsigned i = 0; i < 512; i++) {
+		tables += hgu_l3_of[i] != 0;
+	}
+	lck_mtx_unlock(hg_mtx);
+	printf("NOTEFE GPU: user VA %u of %u 64K chunks used (%u MB), largest free run %u KB, L3 tables %u of %u\n",
+	    used, HGU_CHUNKS, used / 16, best * 64, tables, HGU_L3_MAX);
+}
+
 /* Give back the VA of n pages at va (herolte_gpu_unmap does it). Called with hg_mtx held. */
 static void
 hgu_va_free_locked(uint64_t va, unsigned n)
diff --git a/iokit/Kernel/arm/HeroGPU.cpp b/iokit/Kernel/arm/HeroGPU.cpp
index 3ba3cb8..9bb2ee5 100644
--- a/iokit/Kernel/arm/HeroGPU.cpp
+++ b/iokit/Kernel/arm/HeroGPU.cpp
@@ -43,6 +43,7 @@ extern "C" {
 bool herolte_gpu_up(void);
 uint32_t herolte_gpu_reg(uint32_t off);
 uint64_t herolte_gpu_va_alloc(uint64_t bytes);
+void herolte_gpu_va_report(void);         /* Note FE 0413 */
 bool herolte_gpu_map(uint64_t va, const uint64_t *pages, unsigned n);
 void herolte_gpu_unmap(uint64_t va, unsigned n);
 uint32_t herolte_gpu_submit(unsigned js, uint64_t jc, uint64_t *us);
@@ -209,6 +210,10 @@ herogpu_bo_create(struct herogpu_bo *bo, uint64_t size)
 	bo->mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
 	    kIODirectionInOut | kIOMemoryKernelUserShared, size, page_size);
 	if (bo->mem == NULL) {
+		static unsigned told;
+		if (told++ < 6) {
+			printf("NOTEFE GPU: buffer of %llu KB failed at kernel memory\n", size >> 10);
+		}
 		return false;
 	}
 	uintptr_t k = (uintptr_t)bo->mem->getBytesNoCopy();
@@ -226,7 +231,17 @@ herogpu_bo_create(struct herogpu_bo *bo, uint64_t size)
 		ok = pa[i] != 0;
 	}
 	bo->va = ok ? herolte_gpu_va_alloc(size) : 0;
+	bool va_ok = bo->va != 0;
 	ok = bo->va != 0 && herolte_gpu_map(bo->va, pa, bo->pages);
+	/* Note FE 0413: which step fails (boot 7: CREATE_BO of 5 MB failed, Mesa then crashed backboardd). */
+	if (!ok) {
+		static unsigned told;
+		if (told++ < 6) {
+			printf("NOTEFE GPU: buffer of %llu KB failed at %s\n", size >> 10,
+			    pa == NULL ? "page list" : !va_ok ? "GPU VA" : "GPU map (L3 tables)");
+			herolte_gpu_va_report();
+		}
+	}
 	if (pa != NULL) {
 		IOFreeData(pa, bo->pages * sizeof(uint64_t));
 	}

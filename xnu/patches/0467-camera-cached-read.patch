diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 627eb0c..2640ac4 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1580,6 +1580,24 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
  * (0450). The descriptor and the map are never released. 0 if it cannot be mapped.
  */
 #include <IOKit/IOMemoryDescriptor.h>
+/* Note FE 0467: the same, cacheable (the camera stream's ring: read by the CPU after a cache flush, not written) */
+extern "C" vm_offset_t notefe_physmap_cached(uint64_t pa, uint64_t len);
+extern "C" vm_offset_t
+notefe_physmap_cached(uint64_t pa, uint64_t len)
+{
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)pa, (IOByteCount)len,
+	    kIODirectionInOut);
+	if (!md) {
+		return 0;
+	}
+	IOMemoryMap *map = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapDefaultCache);
+	if (!map) {
+		md->release();
+		return 0;
+	}
+	return (vm_offset_t)map->getVirtualAddress();
+}
+

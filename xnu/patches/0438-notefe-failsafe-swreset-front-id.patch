+static void
+notefe_safe_to_twrp(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("NOTEFE SAFE: the last reset was the watchdog: to recovery in 12 s\n");
+	ns_sleep_ms(12000);
+	notefe_wr(ns_pmu, 0x808, 0x12345678);
+	notefe_wr(ns_pmu, 0x80c, 0x12345674);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	notefe_wr(ns_pmu, 0x400, 1);                            /* SWRESET */
+}

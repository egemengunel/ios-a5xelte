+/*
+ * Note FE (0416): the bot ends its run with "r SECONDS" on kern.notefe_hid (herolte_gl.c): recovery that much later
+ * (plus hg_twrp_thread's 12 s for the log's last flush), instead of waiting for the herotwrp timer. Once only.
+ */
+void herolte_twrp_soon(unsigned seconds);
+void
+herolte_twrp_soon(unsigned seconds)
+{
+	static int started;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = 1;
+	printf("NOTEFE: bot asked for recovery in %u s\n", seconds + 12);
+	if (kernel_thread_start(hg_twrp_thread, (void *)(uintptr_t)seconds, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}

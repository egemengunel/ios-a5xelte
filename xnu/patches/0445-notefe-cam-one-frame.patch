+	{ 0x618c, 0x08d4, 16 }, { 0x618e, 0x08d6, 16 }, { 0x6028, 0x2000, 16 }, { 0x602a, 0x11a8, 16 },
+	{ 0x6f12, 0x3af9, 16 }, { 0x6f12, 0x1410, 16 }, { 0x6f12, 0x39f9, 16 }, { 0x6f12, 0x1410, 16 },
+	{ 0x6028, 0x2000, 16 }, { 0x602a, 0x12bc, 16 }, { 0x6f12, 0x1020, 16 }, { 0x602a, 0x12c2, 16 },
+	{ 0x6f12, 0x1020, 16 }, { 0x6f12, 0x1020, 16 }, { 0x602a, 0x12ca, 16 }, { 0x6f12, 0x1020, 16 },
+	{ 0x6f12, 0x1010, 16 }, { 0x602a, 0x12fc, 16 }, { 0x6f12, 0x1020, 16 }, { 0x602a, 0x1302, 16 },
+	{ 0x6f12, 0x1020, 16 }, { 0x6f12, 0x1020, 16 }, { 0x602a, 0x130a, 16 }, { 0x6f12, 0x1020, 16 },
+	{ 0x6f12, 0x1010, 16 }, { 0x602a, 0x14b8, 16 }, { 0x6f12, 0x0101, 16 }, { 0x602a, 0x14c0, 16 },
+	{ 0x6f12, 0x0000, 16 }, { 0x6f12, 0xffda, 16 }, { 0x6f12, 0xffda, 16 }, { 0x6f12, 0x0000, 16 },

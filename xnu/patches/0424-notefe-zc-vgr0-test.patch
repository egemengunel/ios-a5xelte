+/*
+ * Note FE (0424), zero-copy step 2: one test of the display's own scaler. Only VGR0/VGR1 scale on the 8890 (Samsung's
+ * vpp.h is_vgr); VGR0 is at 0x13e03000 in DISP1, which is powered (boot 21: PMU status 0x3000f). 90 s after start,
+ * VGR0 is set up as Samsung's vpp_reg_init + vpp_set_config do (reset, real-time path, QoS LUT, dynamic gating,
+ * frame alpha, 8-tap/4-tap coefficients for upscaling, sizes, address), reading backboardd's default surface
+ * (0xa0000000, 750x1334, 3008 bytes a row) scaled to 1440x2560, and window 0 is moved from G1 (CHMAP 0) to VGR0
+ * (CHMAP 5, decon_get_win_channel) with a shadow update; 10 s later it goes back to G1. Boot-arg notefe_zctest=1.
+ */
+static const int16_t notefe_hcoef[9][8] = {
+	{ 0, 0, 0, 128, 0, 0, 0, 0 }, { -1, 2, -6, 127, 7, -2, 1, 0 }, { -1, 4, -12, 125, 16, -5, 1, 0 },
+	{ -1, 5, -15, 120, 25, -8, 2, 0 }, { -1, 6, -18, 114, 35, -10, 3, -1 }, { -1, 6, -20, 107, 46, -13, 4, -1 },
+	{ -2, 7, -21, 99, 57, -16, 5, -1 }, { -1, 6, -20, 89, 68, -18, 5, -1 }, { -1, 6, -20, 79, 79, -20, 6, -1 },
+};
+static const int16_t notefe_vcoef[9][4] = {
+	{ 0, 128, 0, 0 }, { -4, 127, 5, 0 }, { -6, 124, 11, -1 }, { -8, 118, 19, -1 }, { -8, 111, 27, -2 },
+	{ -8, 102, 37, -3 }, { -8, 92, 48, -4 }, { -7, 81, 59, -5 }, { -6, 70, 70, -6 },
+};
+
+static void
+notefe_zc_dump(vm_offset_t vgr, vm_offset_t decon, const char *when)
+{
+	printf("NOTEFE ZC: %s: VGR0 enable %#x irq %#x in %#x src %#x img %#x scaled %#x ratio %#x/%#x addr %#x shadow %#x; "
+	    "DECON win0 %#x update %#x\n", when, hg_rd(vgr, 0x00), hg_rd(vgr, 0x04), hg_rd(vgr, 0x08), hg_rd(vgr, 0x10),
+	    hg_rd(vgr, 0x18), hg_rd(vgr, 0x2c), hg_rd(vgr, 0x44), hg_rd(vgr, 0x48), hg_rd(vgr, 0x74), hg_rd(vgr, 0xb74),
+	    hg_rd(decon, 0x130), hg_rd(decon, 0x60));
+}
+
+static void
+notefe_zc_test_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	hg_msleep(90000);
+	vm_offset_t vgr = ml_io_map(0x13e03000u, 0x1000), decon = ml_io_map(HG_DECON_F_PA, 0x1000);
+	vm_offset_t g1 = ml_io_map(HG_IDMA_G1_PA, 0x1000);
+	if (!vgr || !decon || !g1) {
+		printf("NOTEFE ZC: test: mapping failed\n");
+		return;
+	}
+	uint32_t win0 = hg_rd(decon, 0x130);
+	if (((win0 >> 12) & 7) != 0) {
+		printf("NOTEFE ZC: test: window 0 is not on G1 (%#x): not tried\n", win0);
+		return;
+	}
+	notefe_zc_dump(vgr, decon, "before");
+	/* vpp_reg_init */
+	hg_wr(vgr, 0x00, hg_rd(vgr, 0x00) | (1u << 24));               /* SRESET */
+	unsigned n = 0;
+	while ((hg_rd(vgr, 0x00) & (1u << 24)) && n++ < 10000) {
+		delay(10);
+	}
+	if (hg_rd(vgr, 0x00) & (1u << 24)) {
+		printf("NOTEFE ZC: test: VGR0 reset did not finish: not tried\n");
+		return;
+	}
+	hg_wr(vgr, 0x00, hg_rd(vgr, 0x00) | (1u << 16));               /* RT_PATH_EN */
+	hg_wr(vgr, 0x04, (hg_rd(vgr, 0x04) & ~0x36u) | 1u);            /* framedone/deadlock/read-error/reset-done unmasked, IRQ enable */
+	hg_wr(vgr, 0x60, 0x44444444u);
+	hg_wr(vgr, 0x64, 0x44444444u);
+	hg_wr(vgr, 0xa54, 0x3f);
+	hg_wr(vgr, 0x0c, 0xffu << 24);                                  /* OUT_CON: 601 narrow (unused for RGB), frame alpha 0xff */
+	/* vpp_set_config */
+	uint32_t sw = 750, sh = 1334, fw = 3008 / 4, dw = HG_PANEL_W, dh = HG_PANEL_H;
+	uint32_t hr = (sw << 20) / dw, vr = (sh << 20) / dh;
+	hg_wr(vgr, 0x44, hr);
+	hg_wr(vgr, 0x48, vr);
+	for (unsigned i = 0; i < 9; i++) {
+		for (unsigned j = 0; j < 8; j++) {
+			for (unsigned k = 0; k < 2; k++) {
+				hg_wr(vgr, 0x290 + i * 4 + j * 0x24 + k * 0x200, (uint32_t)(int32_t)notefe_hcoef[i][j]);
+			}
+		}
+		for (unsigned j = 0; j < 4; j++) {
+			for (unsigned k = 0; k < 2; k++) {
+				hg_wr(vgr, 0x200 + i * 4 + j * 0x24 + k * 0x200, (uint32_t)(int32_t)notefe_vcoef[i][j]);
+			}
+		}
+	}
+	hg_wr(vgr, 0x08, hg_rd(g1, 0x08) & ~((31u << 11) | (1u << 3) | (1u << 4) | (7u << 8)));  /* G1's IN_CON: ARGB8888 */
+	hg_wr(vgr, 0x14, 0);
+	hg_wr(vgr, 0x10, (sh << 16) | fw);
+	hg_wr(vgr, 0x18, (sh << 16) | sw);
+	hg_wr(vgr, 0x5b0, 0);
+	hg_wr(vgr, 0x5b4, 0);
+	hg_wr(vgr, 0x5b8, 0);
+	hg_wr(vgr, 0x5bc, 0);
+	hg_wr(vgr, 0x2c, (dh << 16) | dw);
+	hg_wr(vgr, 0x74, 0xa0000000u);
+	hg_wr(vgr, 0x94, 0);
+	hg_wr(vgr, 0x1c, 1);
+	hg_wr(vgr, 0xa48, dw * dh);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	notefe_zc_dump(vgr, decon, "VGR0 set");
+	/* window 0 to VGR0 at the next frame */
+	hg_wr(decon, 0x130, (win0 & ~(7u << 12)) | (5u << 12));
+	hg_wr(decon, 0x60, hg_rd(decon, 0x60) | 1u);
+	hg_msleep(500);
+	notefe_zc_dump(vgr, decon, "on VGR0, 0.5 s");
+	hg_msleep(4500);
+	notefe_zc_dump(vgr, decon, "on VGR0, 5 s");
+	hg_msleep(5000);
+	hg_wr(decon, 0x130, win0);
+	hg_wr(decon, 0x60, hg_rd(decon, 0x60) | 1u);
+	hg_msleep(200);
+	notefe_zc_dump(vgr, decon, "back on G1");
+}

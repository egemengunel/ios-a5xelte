-	notefe_pin(pins, 0x180, 2, 2, -1, -1);          /* MCLK out */
+	uint32_t div = notefe_rd(top, 0xb24), mux = notefe_rd(top, 0xb20);
+	notefe_wr(top, 0xb20, mux & ~(7u << 12));       /* 0443: select 0 = OSCCLK, the only parent (read 2); bit 21 kept */
+	for (unsigned n = 0; n < 1000 && ((notefe_rd(top, 0xb28) >> 12) & 7) != 0; n++) {
+		delay(1);
+	}
+	notefe_wr(top, 0xb24, div & ~0xffu);            /* 0440: undivided: 26 MHz */
+	printf("NOTEFE CAM: front: MCLK mux %#x -> %#x (status %#x), divider %#x -> %#x\n", mux, notefe_rd(top, 0xb20),
+	    notefe_rd(top, 0xb28), div, notefe_rd(top, 0xb24));
+	nc_pin(pins, 0x180, 2, 2, -1, -1);          /* MCLK out */
 	delay(5000);
+	printf("NOTEFE CAM: front: pins: gpc0 con %#x dat %#x, gpc1 con %#x dat %#x, gpk0 con %#x, gpc2 pud %#x\n",
+	    notefe_rd(pins, 0x100), notefe_rd(pins, 0x104), notefe_rd(pins, 0x120), notefe_rd(pins, 0x124),
+	    notefe_rd(pins, 0x180), notefe_rd(pins, 0x148));
 	printf("NOTEFE CAM: front: reset high, MCLK on (gpk0 con %#x, divider %#x -> %#x); the lines idle SDA %u SCL %u\n", notefe_rd(pins, 0x180), div, notefe_rd(top, 0xb24),
 	    nc_sda(), (notefe_rd(pins, 0x144) >> NC_SCL) & 1);
 	/* 0439: each line driven low and read back (is the pin ours, is it pulled up), then every address in both orders */
@@ -2068,21 +2137,7 @@ notefe_cam_front_id(vm_offset_t pins)

+++ b/bsd/dev/herolte_gl.c
@@ -1908,19 +1908,69 @@ notefe_cam_probe(int level)
  * voltage bits kept as found, enable bit off.
  */
 static unsigned NC_SDA = 2, NC_SCL = 3;      /* 0439: swapped too in the scan */
+static uint32_t NC_BANK = 0x140;             /* 0443: gpd1 (0x40) for the positive control on the S2MPB02's bus */
 static vm_offset_t nc_pins;
 
+/* 0443: pinctrl@136D0000's banks have 2-bit pull fields (gpc2 reads 0x555 for six pins), not notefe_pin's 4 */
+static void
+nc_pin(vm_offset_t base, uint32_t bank, unsigned pin, int func, int pud, int level)
+{
+	if (level >= 0) {
+		uint32_t dat = notefe_rd(base, bank + 4);
+		notefe_wr(base, bank + 4, level ? (dat | (1u << pin)) : (dat & ~(1u << pin)));
+	}
+	if (pud >= 0) {
+		uint32_t v = notefe_rd(base, bank + 8);
+		notefe_wr(base, bank + 8, (v & ~(3u << (2 * pin))) | ((uint32_t)pud << (2 * pin)));
+	}
+	if (func >= 0) {
+		uint32_t v = notefe_rd(base, bank);
+		notefe_wr(base, bank, (v & ~(0xfu << (4 * pin))) | ((uint32_t)func << (4 * pin)));
+	}
+}
+
 static void
 nc_line(unsigned pin, int high)
 {
-	notefe_pin(nc_pins, 0x140, pin, high ? 0 : 1, 3, high ? -1 : 0);       /* input (pulled up) or output low */
-	delay(5);
+	nc_pin(nc_pins, NC_BANK, pin, high ? 0 : 1, -1, high ? -1 : 0);        /* input (board pull-up) or output low */
+	delay(20);
+	if (high && pin == NC_SCL) {                                          /* clock stretching: wait for SCL high */
+		for (unsigned n = 0; n < 1000 && !((notefe_rd(nc_pins, NC_BANK + 4) >> NC_SCL) & 1); n++) {
+			delay(1);
+		}
+	}
 }
 
 static int
 nc_sda(void)
 {
-	return (notefe_rd(nc_pins, 0x144) >> NC_SDA) & 1;
+	return (notefe_rd(nc_pins, NC_BANK + 4) >> NC_SDA) & 1;
+}
+
+static void nc_start(void);
+static void nc_stop(void);
+static bool nc_byte_out(uint8_t b);
+static uint8_t nc_byte_in(bool ack);
+
+static void
+nc_scan(const char *what)
+{
+	char found[160];
+	int o = 0;
+	found[0] = 0;
+	for (unsigned a = 0x08; a < 0x78; a++) {
+		nc_start();
+		bool ack = nc_byte_out((uint8_t)(a << 1 | 1));
+		if (ack) {
+			(void)nc_byte_in(false);
+		}
+		nc_stop();
+		if (ack && o < (int)sizeof(found) - 8) {
+			o += snprintf(found + o, sizeof(found) - (size_t)o, " %#x", a);
+		}
+	}
+	printf("NOTEFE CAM: scan of %s (bank %#x SDA %u SCL %u): answers at:%s\n", what, NC_BANK, NC_SDA, NC_SCL,
+	    o ? found : " none");
 }
 
 static void
@@ -1995,6 +2045,16 @@ static void

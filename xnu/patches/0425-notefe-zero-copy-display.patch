+extern "C" uint64_t
+notefe_zc_pool_take(uint32_t w, uint32_t h, uint32_t fmt, uint32_t planes, uint32_t size)
+{
+	if (notefe_zc_pool_on < 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("notefe_zc", &on, sizeof(on));
+		notefe_zc_pool_on = on ? 1 : 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	if (!notefe_zc_pool_on || notefe_zc_pool_w == 0 || w != notefe_zc_pool_w || h != notefe_zc_pool_h ||
+	    fmt != 0x42475241u /* BGRA */ || planes != 0 || size > 0x400000 || strcmp(name, "backboardd") != 0) {
+		return 0;
+	}
+	for (unsigned k = 0; k < 3; k++) {
+		if (notefe_zc_slot_pending[k]) {
+			continue;
+		}
+		uint32_t id = notefe_zc_slot_id[k];
+		SweetSurface *alive = id ? sweet_surface_copy(id) : NULL;
+		if (alive != NULL) {
+			alive->release();
+			continue;
+		}
+		notefe_zc_slot_pending[k] = true;
+		notefe_zc_slot_id[k] = 0;
+		uint64_t pa = 0xa0400000ULL + (uint64_t)k * 0x400000;
+		IOLog("NOTEFE ZC: backboardd's %ux%u surface in display memory at %#llx\n", w, h, pa);
+		return pa;
+	}
+	IOLog("NOTEFE ZC: backboardd's %ux%u surface: no display slot free\n", w, h);
+	return 0;
+}
+
+extern "C" void
+notefe_zc_pool_bind(uint64_t pa, uint32_t id)
+{
+	unsigned k = (unsigned)((pa - 0xa0400000ULL) / 0x400000);
+	if (pa >= 0xa0400000ULL && k < 3) {
+		notefe_zc_slot_id[k] = id;
+		notefe_zc_slot_pending[k] = false;
+	}
+}

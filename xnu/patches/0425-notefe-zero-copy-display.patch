+/*
+ * Note FE (0425): zero-copy display. backboardd's full-screen surfaces live in the 16 MiB at 0xa0000000 (the default
+ * one and up to three more: SweetSurface.cpp), so the display can read them: VGR0 (the 8890's scaling channel, set up
+ * as the 0424 test did) reads the frame iOS just finished and scales it to the panel; window 0 is switched to VGR0
+ * (CHMAP 5) once and back to G1 (CHMAP 0) when a frame cannot be shown that way. No GPU copy (4.7 ms a frame), no
+ * GPU time taken from iOS's own drawing. A flip writes VGR0's address with a ping-pong update and waits (at most
+ * ~20 ms) until the display has latched it (0xb74), so iOS (whose SwapEnd waits for this) never draws into the
+ * surface being shown. Brightness is the window's plane alpha over the black background (Samsung's wincon():
+ * ALPHA0 = level, ALPHA1 = 0, PD_FUNC_LEGACY), not the copy's blend. Boot-arg notefe_zc=0: the GPU copy as before.
+ */
+static vm_offset_t zc_vgr, zc_decon;
+static int zc_state;                    /* 0 not set up, 1 VGR0 ready, -1 off */
+static bool zc_on_window;               /* window 0 on VGR0 */
+static uint32_t zc_win0;                /* window 0 as S-Boot left it (G1) */
+static uint32_t zc_bpr, zc_w, zc_h, zc_alpha_level = 256;
+static uint64_t zc_flips, zc_late, zc_off_count, zc_wait_abs;
+
+static uint32_t
+zc_wincon(uint32_t level)
+{
+	uint32_t v = (zc_win0 & ~((7u << 12) | 0xff00ff00u | (7u << 4) | (1u << 6))) | (5u << 12);
+	if (level >= 255) {
+		return v | (0xffu << 24) | (1u << 8);                   /* ALPHA1 0xff, PD_FUNC_COPY: as S-Boot's */
+	}
+	return v | (level << 16) | (0xdu << 8);                         /* ALPHA0 = level, ALPHA1 0, PD_FUNC_LEGACY */
+}
+
+static void
+zc_window_locked(void)
+{
+	uint32_t level = notefe_bright_level;
+	if (zc_on_window && level == zc_alpha_level) {
+		return;
+	}
+	hg_wr(zc_decon, 0x130, zc_wincon(level));
+	hg_wr(zc_decon, 0x60, hg_rd(zc_decon, 0x60) | 1u);
+	zc_alpha_level = level;
+	if (!zc_on_window) {
+		zc_on_window = true;
+		printf("NOTEFE ZC: window 0 on VGR0 (zero copy), brightness %u\n", level);
+	}
+}
+
+static bool
+zc_setup_locked(uint32_t bpr, uint32_t w, uint32_t h)
+{
+	if (zc_state == 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("notefe_zc", &on, sizeof(on));
+		zc_state = -1;
+		zc_vgr = on ? ml_io_map(0x13e03000u, 0x1000) : 0;
+		zc_decon = on ? ml_io_map(HG_DECON_F_PA, 0x1000) : 0;
+		zc_win0 = zc_decon ? hg_rd(zc_decon, 0x130) : 0;
+		if (!zc_vgr || !zc_decon || ((zc_win0 >> 12) & 7) != 0 || !(zc_win0 & 1)) {
+			printf("NOTEFE ZC: %s\n", on ? "window 0 not as S-Boot left it: GPU copy" : "off (notefe_zc=0)");
+			return false;
+		}
+		hg_wr(zc_vgr, 0x00, hg_rd(zc_vgr, 0x00) | (1u << 24));
+		unsigned n = 0;
+		while ((hg_rd(zc_vgr, 0x00) & (1u << 24)) && n++ < 10000) {
+			delay(10);
+		}
+		if (hg_rd(zc_vgr, 0x00) & (1u << 24)) {
+			printf("NOTEFE ZC: VGR0 reset did not finish: GPU copy\n");
+			return false;
+		}
+		hg_wr(zc_vgr, 0x00, hg_rd(zc_vgr, 0x00) | (1u << 16));
+		hg_wr(zc_vgr, 0x04, (hg_rd(zc_vgr, 0x04) & ~0x36u) | 1u);
+		hg_wr(zc_vgr, 0x60, 0x44444444u);
+		hg_wr(zc_vgr, 0x64, 0x44444444u);
+		hg_wr(zc_vgr, 0xa54, 0x3f);
+		hg_wr(zc_vgr, 0x0c, 0xffu << 24);
+		vm_offset_t g1 = ml_io_map(HG_IDMA_G1_PA, 0x1000);
+		hg_wr(zc_vgr, 0x08, (g1 ? hg_rd(g1, 0x08) : 0xff800000u) & ~((31u << 11) | (1u << 3) | (1u << 4) | (7u << 8)));
+		for (unsigned i = 0; i < 9; i++) {
+			for (unsigned j = 0; j < 8; j++) {
+				for (unsigned k = 0; k < 2; k++) {
+					hg_wr(zc_vgr, 0x290 + i * 4 + j * 0x24 + k * 0x200, (uint32_t)(int32_t)notefe_hcoef[i][j]);
+				}
+			}
+			for (unsigned j = 0; j < 4; j++) {
+				for (unsigned k = 0; k < 2; k++) {
+					hg_wr(zc_vgr, 0x200 + i * 4 + j * 0x24 + k * 0x200, (uint32_t)(int32_t)notefe_vcoef[i][j]);
+				}
+			}
+		}
+		hg_wr(zc_vgr, 0x14, 0);
+		hg_wr(zc_vgr, 0x5b0, 0);
+		hg_wr(zc_vgr, 0x5b4, 0);
+		hg_wr(zc_vgr, 0x5b8, 0);
+		hg_wr(zc_vgr, 0x5bc, 0);
+		hg_wr(zc_vgr, 0x2c, (HG_PANEL_H << 16) | HG_PANEL_W);
+		hg_wr(zc_vgr, 0xa48, HG_PANEL_W * HG_PANEL_H);
+		hg_wr(zc_vgr, 0x94, 0);
+		zc_state = 1;
+		printf("NOTEFE ZC: VGR0 set up for zero copy (window 0 was %#x)\n", zc_win0);
+	}
+	if (zc_state != 1) {
+		return false;
+	}
+	if (bpr != zc_bpr || w != zc_w || h != zc_h) {
+		if (w == 0 || h == 0 || w * 2 < HG_PANEL_W || h * 2 < HG_PANEL_H || w > HG_PANEL_W || h > HG_PANEL_H ||
+		    (bpr & 3) || bpr / 4 < w) {
+			return false;                           /* beyond the scaler's 2x (vpp_check_scale_ratio) */
+		}
+		hg_wr(zc_vgr, 0x10, (h << 16) | (bpr / 4));
+		hg_wr(zc_vgr, 0x18, (h << 16) | w);
+		hg_wr(zc_vgr, 0x44, (w << 20) / HG_PANEL_W);
+		hg_wr(zc_vgr, 0x48, (h << 20) / HG_PANEL_H);
+		zc_bpr = bpr;
+		zc_w = w;
+		zc_h = h;
+	}
+	return true;
+}
+
+bool notefe_zc_flip(uint64_t pa, uint32_t bpr, uint32_t w, uint32_t h);
+bool
+notefe_zc_flip(uint64_t pa, uint32_t bpr, uint32_t w, uint32_t h)
+{
+	if (zc_state < 0 || pa == 0 || pa + (uint64_t)bpr * h > 0x100000000ull) {
+		return false;
+	}
+	lck_mtx_lock(hg_mtx);
+	bool ok = zc_setup_locked(bpr, w, h);
+	if (ok) {
+		uint64_t t0 = mach_absolute_time(), limit;
+		nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &limit);
+		hg_wr(zc_vgr, 0x74, (uint32_t)pa);
+		hg_wr(zc_vgr, 0x1c, 1);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		zc_window_locked();
+		while (hg_rd(zc_vgr, 0xb74) != (uint32_t)pa && mach_absolute_time() - t0 < limit) {
+			delay(50);
+		}
+		zc_late += hg_rd(zc_vgr, 0xb74) != (uint32_t)pa;
+		zc_wait_abs += mach_absolute_time() - t0;
+		if (++zc_flips <= 3 || zc_flips % 1800 == 0) {
+			uint64_t us;
+			absolutetime_to_nanoseconds(zc_wait_abs / zc_flips, &us);
+			printf("NOTEFE ZC: flip %llu to %#llx (%ux%u, %u a row): %llu not latched in 20 ms, %llu us to latch on "
+			    "average, %llu falls back to the copy; VGR0 irq %#x\n", zc_flips, pa, w, h, bpr, zc_late, us / 1000,
+			    zc_off_count, hg_rd(zc_vgr, 0x04));
+		}
+	}
+	lck_mtx_unlock(hg_mtx);
+	return ok;
+}
+
+/* A frame that is not shown by VGR0 (or the panel going off): window 0 back on G1, which the copy fills. */
+void notefe_zc_off(void);
+void
+notefe_zc_off(void)
+{
+	if (!zc_on_window) {
+		return;
+	}
+	lck_mtx_lock(hg_mtx);
+	if (zc_on_window) {
+		hg_wr(zc_decon, 0x130, zc_win0);
+		hg_wr(zc_decon, 0x60, hg_rd(zc_decon, 0x60) | 1u);
+		zc_on_window = false;
+		zc_alpha_level = 256;
+		zc_bpr = 0;
+		if (++zc_off_count <= 10 || zc_off_count % 100 == 0) {
+			printf("NOTEFE ZC: window 0 back on G1 (%llu times)\n", zc_off_count);
+		}
+	}
+	lck_mtx_unlock(hg_mtx);
+}
+
+bool notefe_zc_active(void);
+bool
+notefe_zc_active(void)
+{
+	return zc_on_window;
+}

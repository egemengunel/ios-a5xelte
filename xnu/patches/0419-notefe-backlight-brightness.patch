 	hg_wr64(scr, S_FBD + 128 + 32, target_va);
+	/* Note FE (0419): brightness. Blend A + B * C with A = 0, B = source and C = the blend constant (level / 255),
+	 * instead of C = 1 - 0; alpha and the colour mask as before. 255: the copy exactly as before. */
+	{
+		uint32_t level = notefe_bright_level;
+		union { float f; uint32_t u; } k = { .f = (float)level / 255.0f };
+		hg_wr32(scr, S_RSD + 72, level >= 255 ? 0xf0921921u : 0xf0921721u);
+		hg_wr32(scr, S_RSD + 76, k.u);

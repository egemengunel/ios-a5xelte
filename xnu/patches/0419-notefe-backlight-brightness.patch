diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
index 28b8f98..ad322c2 100644
--- a/bsd/dev/herolte_gl.c
+++ b/bsd/dev/herolte_gl.c
@@ -449,6 +449,32 @@ notefe_hid_sysctl SYSCTL_HANDLER_ARGS
 	return EINVAL;
 }
 
+/*
+ * Note FE (0419): kern.notefe_brightness, 0-255 (12 at least). SpringBoard's bridge (notefe/herosb) writes iOS's
+ * brightness here, as Scion's brightness_bridge does on the Galaxy S9; read it back with sysctl.
+ */
+extern void notefe_brightness_set(uint32_t level, const char *why);
+extern uint32_t notefe_brightness_get(void);
+
+static int
+notefe_brightness_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = (int)notefe_brightness_get();
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (value < 0 || value > 255) {
+		return EINVAL;
+	}
+	notefe_brightness_set((uint32_t)value, "sysctl");
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, notefe_brightness, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, notefe_brightness_sysctl, "I", "Note FE: panel brightness 0-255");
+
 SYSCTL_PROC(_kern, OID_AUTO, notefe_hid, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
     NULL, 0, notefe_hid_sysctl, "A", "Note FE: synthetic touches and keys (boot-arg herobot=1)");
 #endif /* ARM64_BOARD_CONFIG_HEROLTE */
diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index bfa8f8f..33dccba 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1893,6 +1893,33 @@ herolte_fb_two_buffers(void)
  * the rect to the point of coherency. False if the GPU failed (the caller
  * falls back to the CPU copy).
  */
+/* Note FE (0419): the panel's brightness, 255 = as drawn. Set by kern.notefe_brightness and the backlight service. */
+static volatile uint32_t notefe_bright_level = 255;
+
+void notefe_brightness_set(uint32_t level, const char *why);
+void
+notefe_brightness_set(uint32_t level, const char *why)
+{
+	static uint32_t logged;
+	if (level > 255) {
+		level = 255;
+	}
+	if (level < 12) {
+		level = 12;             /* never black: the slider at 0 is dim, as on an iPhone */
+	}
+	if (level != notefe_bright_level && (++logged <= 60 || logged % 50 == 0)) {
+		printf("NOTEFE BRIGHT: %u -> %u (%s)\n", notefe_bright_level, level, why);
+	}
+	notefe_bright_level = level;
+}
+
+uint32_t notefe_brightness_get(void);
+uint32_t
+notefe_brightness_get(void)
+{
+	return notefe_bright_level;
+}

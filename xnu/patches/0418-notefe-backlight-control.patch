+/*
+ * Note FE (0418): what CoreBrightness sets on the display, logged (the first 200 calls and every 100th after), so the
+ * panel's brightness can follow it. Nothing is refused.
+ */
+static void
+notefe_log_props(const char *who, OSObject *properties)
+{
+	static uint32_t calls;
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	uint32_t n = ++calls;
+	if (dict == NULL || (n > 200 && n % 100 != 0)) {
+		return;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return;
+	}
+	while (OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject())) {
+		OSObject *v = dict->getObject(key);
+		OSNumber *num = OSDynamicCast(OSNumber, v);
+		OSBoolean *b = OSDynamicCast(OSBoolean, v);
+		OSData *d = OSDynamicCast(OSData, v);
+		OSDictionary *sub = OSDynamicCast(OSDictionary, v);
+		if (num) {
+			IOLog("NOTEFE BRIGHT: %s #%u %s = %llu (%#llx)\n", who, n, key->getCStringNoCopy(),
+			    num->unsigned64BitValue(), num->unsigned64BitValue());
+		} else if (b) {
+			IOLog("NOTEFE BRIGHT: %s #%u %s = %s\n", who, n, key->getCStringNoCopy(), b->isTrue() ? "true" : "false");
+		} else if (d) {
+			const uint8_t *p = (const uint8_t *)d->getBytesNoCopy();
+			unsigned len = d->getLength();
+			IOLog("NOTEFE BRIGHT: %s #%u %s = data %u: %02x %02x %02x %02x %02x %02x %02x %02x\n", who, n,
+			    key->getCStringNoCopy(), len, len > 0 ? p[0] : 0, len > 1 ? p[1] : 0, len > 2 ? p[2] : 0,
+			    len > 3 ? p[3] : 0, len > 4 ? p[4] : 0, len > 5 ? p[5] : 0, len > 6 ? p[6] : 0, len > 7 ? p[7] : 0);
+		} else if (sub) {
+			IOLog("NOTEFE BRIGHT: %s #%u %s = dictionary of %u\n", who, n, key->getCStringNoCopy(), sub->getCount());
+			notefe_log_props(who, sub);
+		} else {
+			IOLog("NOTEFE BRIGHT: %s #%u %s = %s\n", who, n, key->getCStringNoCopy(),
+			    v ? v->getMetaClass()->getClassName() : "null");
+		}
+	}
+	it->release();
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	notefe_log_props("display", properties);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::setProperties(OSObject *properties)
+{
+	notefe_log_props("client", properties);
+	return kIOReturnSuccess;
+}

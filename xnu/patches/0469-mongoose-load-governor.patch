diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 3456e94..7db3f46 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -21,6 +21,9 @@
 #include <mach/mach_time.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <kern/processor.h>
+#include <mach/processor_info.h>
+#include <mach/machine.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 void herolte_gpu_probe(void);
@@ -2665,6 +2668,22 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 		}
 	}
 	printf("HEROLTE POWER: Mongoose to %u MHz with the screen off or the SoC at %u C (back under %u C)\n", hp_boot_mhz(), hot, cool);
+	/*
+	 * Note FE 0469: herogov=1, a load governor. The big cores stayed at herocpu_mhz (high voltage) the whole time the
+	 * screen was on (heat; 2600 vs 2288 MHz made no difference to the UI, boot 19). Every 200 ms the four Mongoose
+	 * cores' busy share (processor_info CPU_LOAD ticks, cpus 4-7) is read: under herogov_lo percent (15) for herogov_ms
+	 * (2000) the cluster goes to the bootloader's rate (hc_go_low), over it straight back up (hc_go_high).
+	 */
+	extern kern_return_t processor_info(processor_t, processor_flavor_t, host_t *, processor_info_t, mach_msg_type_number_t *);
+	uint32_t gov = 0, gov_lo = 15, gov_ms = 2000, gov_quiet_ms = 0, gov_switches = 0;
+	unsigned int gov_last[8][CPU_STATE_MAX];
+	bool gov_have = false;
+	PE_parse_boot_argn("herogov", &gov, sizeof(gov));
+	PE_parse_boot_argn("herogov_lo", &gov_lo, sizeof(gov_lo));
+	PE_parse_boot_argn("herogov_ms", &gov_ms, sizeof(gov_ms));
+	if (gov) {
+		printf("HEROLTE POWER: governor on: Mongoose down after %u ms under %u%% busy\n", gov_ms, gov_lo);
+	}
 	bool hot_now = false;
 	uint64_t last_log = 0;
 	int top = -1000, seen_max = -1000;
@@ -2697,19 +2716,52 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 				hot_now = false;
 			}
 		}
-		bool want_low = screen_off || hot_now;
+		bool idle_low = false;
+		if (gov) {
+			uint64_t busy = 0, all = 0;
+			for (int cpu = 4; cpu < 8; cpu++) {
+				processor_t pr = cpu_to_processor(cpu);
+				processor_cpu_load_info_data_t li;
+				mach_msg_type_number_t cnt = PROCESSOR_CPU_LOAD_INFO_COUNT;
+				host_t h;
+				if (pr == PROCESSOR_NULL || processor_info(pr, PROCESSOR_CPU_LOAD_INFO, &h, (processor_info_t)&li, &cnt) != KERN_SUCCESS) {
+					continue;
+				}
+				if (gov_have) {
+					unsigned int u = li.cpu_ticks[CPU_STATE_USER] - gov_last[cpu][CPU_STATE_USER],
+					    sy = li.cpu_ticks[CPU_STATE_SYSTEM] - gov_last[cpu][CPU_STATE_SYSTEM],
+					    id = li.cpu_ticks[CPU_STATE_IDLE] - gov_last[cpu][CPU_STATE_IDLE];
+					busy += u + sy;
+					all += u + sy + id;
+				}
+				memcpy(gov_last[cpu], li.cpu_ticks, sizeof(li.cpu_ticks));
+			}
+			gov_have = true;
+			if (all > 0 && busy * 100 > all * gov_lo) {
+				gov_quiet_ms = 0;
+			} else if (all > 0) {
+				gov_quiet_ms += 200;
+			}
+			idle_low = gov_quiet_ms >= gov_ms;
+		}
+		bool want_low = screen_off || hot_now || idle_low;
 		if (!hc.broken && want_low == hc.high) {
 			bool ok = want_low ? hc_go_low() : hc_go_high();
-			printf("HEROLTE POWER: Mongoose %s %u MHz (screen %s%s, SoC %d C)\n", ok ? "to" : "NOT to",
-			    want_low ? hp_boot_mhz() : hc.mhz, screen_off ? "off" : "on", hot_now ? ", hot" : "", top);
+			gov_switches++;
+			if (!gov || screen_off || hot_now || gov_switches <= 10) {
+				printf("HEROLTE POWER: Mongoose %s %u MHz (screen %s%s%s, SoC %d C)\n", ok ? "to" : "NOT to",
+				    want_low ? hp_boot_mhz() : hc.mhz, screen_off ? "off" : "on", hot_now ? ", hot" : "",
+				    idle_low ? ", idle" : "", top);
+			}
 		}
 		uint64_t since = 0;
 		absolutetime_to_nanoseconds(now - last_log, &since);
 		if (last_log == 0 || since > 60ull * NSEC_PER_SEC) {
 			last_log = now;
 			int b = herolte_fg_temp_dc;
-			printf("HEROLTE POWER: SoC %d C (big %d, little %d, GPU %d, ISP %d; most %d), battery reg %d.%u C, Mongoose %s, screen %s\n",
-			    top, c[0], c[1], c[2], c[3], seen_max, b / 10, (unsigned)(b < 0 ? -b : b) % 10, hc.high ? "up" : "down", off ? "off" : "on");
+			printf("HEROLTE POWER: SoC %d C (big %d, little %d, GPU %d, ISP %d; most %d), battery reg %d.%u C, Mongoose %s, screen %s, "
+			    "switches %u\n", top, c[0], c[1], c[2], c[3], seen_max, b / 10, (unsigned)(b < 0 ? -b : b) % 10,
+			    hc.high ? "up" : "down", off ? "off" : "on", gov_switches);
 			seen_max = -1000;
 		}
 	}

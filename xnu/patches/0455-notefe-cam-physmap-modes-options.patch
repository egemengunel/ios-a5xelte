+
+/*
+ * Note FE (0455): physical memory outside XNU's RAM (the camera ION range) mapped into the kernel for good, through an
+ * IOMemoryDescriptor, write-combined (normal memory, not cached: what a device's DMA writes is what the processor reads).
+ * The S9 ports' hakios.physmap does the same; ml_io_map's io_submap is only 8 MB, and freeing its pieces hung the boot
+ * (0450). The descriptor and the map are never released. 0 if it cannot be mapped.
+ */
+#include <IOKit/IOMemoryDescriptor.h>
+extern "C" vm_offset_t notefe_physmap(uint64_t pa, uint64_t len);
+extern "C" vm_offset_t
+notefe_physmap(uint64_t pa, uint64_t len)
+{
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)pa, (IOByteCount)len,
+	    kIODirectionInOut);
+	if (!md) {
+		return 0;
+	}
+	IOMemoryMap *map = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+	if (!map) {
+		md->release();
+		return 0;
+	}
+	return (vm_offset_t)map->getVirtualAddress();
+}

 		return EINVAL;
 	}
 	notefe_bt_last = value;
@@ -767,7 +888,7 @@ notefe_bt_sysctl SYSCTL_HANDLER_ARGS
 }
 
 SYSCTL_PROC(_kern, OID_AUTO, notefe_bt, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
-    NULL, 0, notefe_bt_sysctl, "I", "Note FE: Bluetooth (1-2 read only, 3 UART loopback, 4 chip power, 5 HCI version, 6 chip off)");
+    NULL, 0, notefe_bt_sysctl, "I", "Note FE: Bluetooth (1-2 read only, 3 UART loopback, 4 chip power, 5 HCI version, 6 chip off, 7 + patch)");
 

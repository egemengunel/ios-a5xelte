  * next boot on. DROP_DIR disabled.list, one job a line, adds to them with no new build: 41 at once left SpringBoard
  * waiting for ever behind a black screen, so which ones are safe is found by trying.
  */
+/* Is NAME one of the lines of LIST? */
+static int
+job_listed(const char *list, const char *name)
+{
+   size_t n = strlen(name);
+   for (const char *t = list; *t;) {
+      size_t len = strcspn(t, " \t\r\n");
+      if (len == n && strncmp(t, name, n) == 0)
+         return 1;
+      t += len;
+      t += strspn(t, " \t\r\n");
+   }
+   return 0;
+}
